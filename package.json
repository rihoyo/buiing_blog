{
  "name": "buiing-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:community-ui": "node scripts/community-browser.mjs",
    "test:counter": "node scripts/counter-browser.mjs",
    "test:editor-ui": "node scripts/editor-browser.mjs",
    "test:editor-features": "node scripts/editor-features-browser.mjs",
    "test:editor-private-table": "node scripts/editor-private-table-browser.mjs",
    "test:home-privacy-drafts": "node scripts/home-privacy-drafts-browser.mjs",
    "test:guest-ui": "node scripts/guest-ui-browser.mjs",
    "format": "prettier --write app.js community.js blog-editor.js style.css assets/*.js supabase/functions/*/index.ts scripts/build.mjs",
    "format:check": "prettier --check app.js community.js blog-editor.js style.css assets/*.js supabase/functions/*/index.ts scripts/build.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2"
  }
}
